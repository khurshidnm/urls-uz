# ==========================================
# urls.uz — Muhit Sozlamalari (Environment)
# ==========================================

# 1. Sayt Asosiy Manzili
NEXT_PUBLIC_APP_URL="https://urls.uz"

# 2. Telegram Bot Sozlamalari
# @BotFather orqali bot oching va /setdomain buyrug'i bilan domeningizni kiriting
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="urls_uz_bot"
TELEGRAM_BOT_TOKEN="1234567890:AAExampleTelegramBotTokenHere"

# 3. Telegram Gateway API (Ixtiyoriy - Telegram orqali rasmiy OTP SMS yuborish)
# Ro'yxatdan o'tish: https://gateway.telegram.org
TELEGRAM_GATEWAY_TOKEN=""

# 4. Google OAuth Sozlamalari (Google Console orqali)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. Xavfsizlik kaliti (Sessiyalar shifrlash uchun)
AUTH_SECRET="urls_uz_super_secret_session_encryption_key_2026"
