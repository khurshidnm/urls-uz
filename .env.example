# ==========================================
# urls.uz — Muhit Sozlamalari (Environment)
# ==========================================

# 1. Sayt Asosiy Manzili
NEXT_PUBLIC_APP_URL="https://urls.uz"

# 1b. Postgres ma'lumotlar bazasi
DATABASE_URL="postgres://localhost:5432/urls_uz"

# 2. Telegram Bot Sozlamalari
# @BotFather orqali bot oching va /setdomain buyrug'i bilan domeningizni kiriting
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="urls_uz_bot"
TELEGRAM_BOT_TOKEN="1234567890:AAExampleTelegramBotTokenHere"
TELEGRAM_WEBHOOK_SECRET="urls_uz_webhook_secret_key_v3_2026"

# 3. Telegram Gateway API (Ixtiyoriy - Telegram orqali rasmiy OTP SMS yuborish)
# Ro'yxatdan o'tish: https://gateway.telegram.org
TELEGRAM_GATEWAY_TOKEN=""

# 4. Google OAuth Sozlamalari (Google Console orqali)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. Xavfsizlik kaliti (parol bilan himoyalangan havolalar va IP xeshlash uchun)
# Productionda majburiy. Yaratish: openssl rand -hex 32
AUTH_SECRET=""

# 6. Super admin huquqi (faqat server tomonidan beriladi, vergul bilan ajrating)
ADMIN_EMAILS=
ADMIN_TELEGRAM_IDS=

# 7. Bosishlar statistikasi
# Eski xom bosishlarni (tashriflar jurnali) tarif muddatidan keyin o‘chiruvchi kunlik vazifa:
#   Vercel Cron: GET /api/cron/prune-clicks (Authorization: Bearer $CRON_SECRET)
#   yoki serverda cron: npm run clicks:prune
# Kunlik jamlanmalar (link_stats_daily) doim saqlanadi. Yaratish: openssl rand -hex 32
CRON_SECRET=""
# Bosishlar yozilishidan oldin necha millisekund to‘planadi (standart 1000)
# CLICK_FLUSH_MS=1000
